{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "outDir": "./dist",
    "rootDir": "./src/frontend",
    "removeComments": true,
    "skipLibCheck": true
  },
  "include": ["src/frontend/**/*.ts"]
}